{
  "name": "beananza",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @beananza/client dev",
    "build": "pnpm --filter @beananza/client build",
    "preview": "pnpm --filter @beananza/client preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "shot": "pnpm --filter @beananza/shot shot",
    "shot:install": "pnpm --filter @beananza/shot install-browser",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "shot:check-carts": "pnpm --filter @beananza/shot check-carts",
    "shot:compare-states": "pnpm --filter @beananza/shot compare-states",
    "shot:check-looks": "pnpm --filter @beananza/shot check-looks",
    "share": "pnpm --filter @beananza/share share",
    "share:preview": "pnpm --filter @beananza/share preview",
    "share:dry-run": "pnpm share && pnpm --filter @beananza/share cf-check",
    "share:deploy": "pnpm share && pnpm --filter @beananza/share cf-deploy",
    "share:password": "pnpm --filter @beananza/share cf-password"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
