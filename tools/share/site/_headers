# Response headers for the share site on Cloudflare (Workers static assets).
# For people with the link, not search engines; no referrer leaks to other sites.
/*
  X-Robots-Tag: noindex
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# The game build's file names carry a content hash, so they never change. Private: the site is
# behind a password, so only the visitor's own browser may keep a copy.
/play/assets/*
  Cache-Control: private, max-age=31536000, immutable
