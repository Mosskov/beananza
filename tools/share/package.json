{
  "name": "@beananza/share",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Builds the team preview site (docs, screenshots, playable build) into artifacts/share/.",
  "scripts": {
    "share": "tsx src/share.ts",
    "preview": "vite preview --outDir ../../artifacts/share --port 4190 --strictPort",
    "cf-deploy": "wrangler deploy",
    "cf-check": "wrangler deploy --dry-run",
    "cf-password": "wrangler secret put SITE_PASSWORD",
    "cf-migrate": "wrangler d1 migrations apply beananza-comments --remote",
    "cf-comments": "wrangler d1 execute beananza-comments --remote --command \"SELECT id, decision, name, created_at, body FROM comments ORDER BY id\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "marked": "18.0.14",
    "tsx": "4.23.15",
    "vite": "8.3.1",
    "wrangler": "4.143.0"
  }
}
